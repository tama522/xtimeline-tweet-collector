# XTimeline Widget API 環境設定ファイル
# 使用方法: .env.example を .env にコピーして設定を変更してください

# サーバーポート設定
PORT=3000

# 環境設定
NODE_ENV=development

# データベース設定
DB_PATH=../timeline.db

# CORS設定
ALLOWED_ORIGINS=*

# レート制限設定
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# セキュリティ設定
ENABLE_CORS=true
ENABLE_RATE_LIMITING=true

# ログ設定
LOG_LEVEL=info
LOG_FILE=logs/widget-api.log

# SSL設定（本番環境用）
SSL_CERT_PATH=/etc/letsencrypt/live/lajelly.x-timeline.net/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/lajelly.x-timeline.net/privkey.pem
ENABLE_HTTPS=false