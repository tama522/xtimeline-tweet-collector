# XTimeline Widget API 本番環境設定

# サーバーポート設定（Nginxプロキシ経由の場合は3000のまま）
PORT=3000

# 環境設定
NODE_ENV=production

# データベース設定
DB_PATH=../timeline.db

# CORS設定（本番環境では特定のドメインに制限）
ALLOWED_ORIGINS=https://lajelly.x-timeline.net

# レート制限設定（本番環境では厳格に）
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=60

# セキュリティ設定
ENABLE_CORS=true
ENABLE_RATE_LIMITING=true

# ログ設定
LOG_LEVEL=warn
LOG_FILE=/var/log/xtimeline/widget-api.log

# SSL設定（直接HTTPSで起動する場合）
SSL_CERT_PATH=/etc/letsencrypt/live/lajelly.x-timeline.net/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/lajelly.x-timeline.net/privkey.pem
ENABLE_HTTPS=false